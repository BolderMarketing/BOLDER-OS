# BOLDER OS — Environment Variables
# Copy to .env (root) for local dev, or add each as a Replit Secret in production.
# NEVER commit the real .env file. It is gitignored.

# --- Supabase (Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Auth ---
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Anthropic (Claude) — server-side only, never exposed to frontend ---
ANTHROPIC_API_KEY=
ACE_MODEL=claude-sonnet-4-6

# --- Twilio (SMS / voice memo intake) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FARIS_PHONE_NUMBER=

# --- OpenAI (Whisper transcription) ---
OPENAI_API_KEY=

# --- Server / CORS ---
PORT=3001
# Replit frontend URL (production) for CORS lock + cookie domain. Comma-separate for multiple.
CLIENT_URL=http://localhost:5173
# Set to "production" on Replit
NODE_ENV=development

# --- Twilio webhook public base URL (used to validate X-Twilio-Signature) ---
# e.g. https://your-app.replit.app  — must match the URL Twilio posts to.
PUBLIC_URL=
